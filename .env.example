# Styli — copy to `.env` and fill in values from your Supabase project settings.
# Never commit real secrets. The mobile app must only use the anon key.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Edge Function secrets / local scripts — never ship to the app)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Local Stage 3 testing only (optional). Production Edge Function should use OPENAI_API_KEY.
ALLOW_HEURISTIC_FALLBACK=false

# RevenueCat public SDK keys
# Development / Expo: use a Test Store key (starts with test_) from Project Settings → API keys
EXPO_PUBLIC_REVENUECAT_API_KEY=test_YOUR_TEST_STORE_KEY
# Optional platform overrides for release builds
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_IOS_KEY
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_ANDROID_KEY
# EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_YOUR_WEB_BILLING_KEY

# Product identifiers (must match RevenueCat / Test Store products attached to the `premium` entitlement)
# EXPO_PUBLIC_RC_MONTHLY_PRODUCT_ID=vibe_premium_monthly
# EXPO_PUBLIC_RC_YEARLY_PRODUCT_ID=vibe_premium_yearly
