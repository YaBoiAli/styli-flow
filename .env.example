# Styli — copy to `.env` and fill in values from your Supabase project settings.
# Never commit real secrets. The mobile app must only use the anon key.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side / seeding only (do NOT put this in the Expo app or commit it)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
