{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_REVENUECAT_API_KEY": "test_REPLACE_WITH_TEST_STORE_KEY"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_REVENUECAT_API_KEY": "test_REPLACE_WITH_TEST_STORE_KEY"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "appl_REPLACE_WITH_IOS_KEY",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "goog_REPLACE_WITH_ANDROID_KEY"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
